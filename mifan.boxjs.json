{
  "id": "com.mifan.checkin",
  "name": "米饭签到",
  "description": "米饭(mifan.61.com)每日签到 - Token 管理",
  "author": "@1009394958",
  "homepage": "https://github.com/1009394958/mifan-checkin",
  "icon": "https://mifan.61.com/favicon.ico",
  "settings": [
    {
      "id": "mf_token",
      "name": "登录 Token",
      "desc": "从浏览器 localStorage.MF_AUTH 获取，或配置 MITM 自动捕获",
      "type": "text",
      "val": "",
      "placeholder": "粘贴你的 Token"
    },
    {
      "id": "mf_username",
      "name": "账号",
      "desc": "淘米账号/手机号（仅用于显示区分多账号）",
      "type": "text",
      "val": "",
      "placeholder": "选填"
    }
  ],
  "scripts": [
    {
      "name": "检查签到状态",
      "url": "https://raw.githubusercontent.com/1009394958/mifan-checkin/main/mifan_checkin.js",
      "argument": "action=status"
    },
    {
      "name": "执行签到",
      "url": "https://raw.githubusercontent.com/1009394958/mifan-checkin/main/mifan_checkin.js",
      "argument": "action=sign"
    }
  ]
}
